DT_COMPAT_HPMICRO_HPM_GPIO := hpmicro,hpm-gpio

config GPIO_HPMICRO
	bool "HPMicro GPIO driver"
	default y
	depends on DT_HAS_HPMICRO_HPM_GPIO_ENABLED
	depends on HAS_HPMSDK_GPIO
	select USE_HPMSDK_GPIO
	help
	  Enable the HPMicro GPIO driver.

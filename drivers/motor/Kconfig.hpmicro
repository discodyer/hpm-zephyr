DT_COMPAT_HPM_QEO := hpmicro,hpm-qeo

config QEO_HPMICRO
	bool "HPMicro QEO encoder output driver"
	default y
	depends on CLOCK_CONTROL
	depends on DT_HAS_HPMICRO_HPM_QEO_ENABLED
	depends on HAS_HPMSDK_QEO
	select USE_HPMSDK_QEO
	help
	  Enable the HPMicro quadrature encoder output driver. The initial
	  adaptation supports ABZ output, software position injection and
	  internal position readback.

DT_COMPAT_HPM_SEI := hpmicro,hpm-sei

config SEI_HPMICRO
	bool "HPMicro serial encoder interface driver"
	default y
	depends on CLOCK_CONTROL
	depends on DT_HAS_HPMICRO_HPM_SEI_ENABLED
	depends on HAS_HPMSDK_SEI
	select USE_HPMSDK_SEI
	help
	  Enable the HPMicro serial encoder interface. This is a protocol-neutral
	  execution layer for transceiver, instruction, latch, SAMPLE/UPDATE and
	  engine configuration. Encoder protocols are implemented by consumers.

DT_COMPAT_HPM_MMC := hpmicro,hpm-mmc

config MMC_HPMICRO
	bool "HPMicro motion processing unit driver"
	default y
	depends on CLOCK_CONTROL
	depends on DT_HAS_HPMICRO_HPM_MMC_ENABLED
	depends on HAS_HPMSDK_MMC
	select USE_HPMSDK_MMC
	help
	  Enable the HPMicro motion processing unit. The initial driver exposes
	  track and predictor configuration, position and trigger inputs,
	  result/status access and module control. Interrupt callbacks and TRGM
	  position routing are not exposed yet.

DT_COMPAT_HPM_RDC := hpmicro,hpm-rdc

config RDC_HPMICRO
	bool "HPMicro resolver-to-digital converter driver"
	default y
	depends on CLOCK_CONTROL
	depends on DT_HAS_HPMICRO_HPM_RDC_ENABLED
	depends on HAS_HPMSDK_RDC
	select USE_HPMSDK_RDC
	help
	  Enable the HPMicro resolver-to-digital converter. The initial driver
	  covers excitation output, I/Q accumulation input, accumulation
	  filtering, trigger output and result access. Interrupt callbacks and
	  TRGM/DAC routing are not exposed yet.

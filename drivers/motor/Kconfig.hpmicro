DT_COMPAT_HPM_QEO := hpmicro,hpm-qeo

config QEO_HPMICRO
	bool "HPMicro QEO encoder output driver"
	default y
	depends on CLOCK_CONTROL
	depends on DT_HAS_HPMICRO_HPM_QEO_ENABLED
	depends on HAS_HPMSDK_QEO
	select USE_HPMSDK_QEO
	help
	  Enable the HPMicro quadrature encoder output driver. The driver supports
	  ABZ output, three-channel WAVE output, PWM FORCE phase tables, PWM
	  safety mode, software position injection and internal position readback.
	  Position routing through TRGM/MMC is not included.

DT_COMPAT_HPM_SEI := hpmicro,hpm-sei

config SEI_HPMICRO
	bool "HPMicro serial encoder interface driver"
	default y
	depends on CLOCK_CONTROL
	depends on DT_HAS_HPMICRO_HPM_SEI_ENABLED
	depends on HAS_HPMSDK_SEI
	select USE_HPMSDK_SEI
	help
	  Enable the HPMicro serial encoder interface. This is a protocol-neutral
	  execution layer for transceiver, instruction, latch, SAMPLE/UPDATE,
	  engine, trigger and interrupt configuration. Encoder protocols are
	  implemented by consumers.

DT_COMPAT_HPM_MMC := hpmicro,hpm-mmc

config MMC_HPMICRO
	bool "HPMicro motion processing unit driver"
	default y
	depends on CLOCK_CONTROL
	depends on DT_HAS_HPMICRO_HPM_MMC_ENABLED
	depends on HAS_HPMSDK_MMC
	select USE_HPMSDK_MMC
	help
	  Enable the HPMicro motion processing unit. The driver exposes track and
	  predictor configuration, position and trigger inputs, result/status
	  access, module control and shared-IRQ event callbacks for the track and
	  both predictors. TRGM position routing remains the consumer's
	  responsibility.

DT_COMPAT_HPM_RDC := hpmicro,hpm-rdc

config RDC_HPMICRO
	bool "HPMicro resolver-to-digital converter driver"
	default y
	depends on CLOCK_CONTROL
	depends on DT_HAS_HPMICRO_HPM_RDC_ENABLED
	depends on HAS_HPMSDK_RDC
	select USE_HPMSDK_RDC
	help
	  Enable the HPMicro resolver-to-digital converter. The driver covers
	  excitation output, I/Q accumulation input, accumulation filtering,
	  trigger output, result access, integer-CORDIC phase calculation and
	  W1C interrupt event handling. TRGM or DAC routing remains the
	  consumer's responsibility.

DT_COMPAT_HPM_SYNT := hpmicro,hpm-synt

config SYNT_HPMICRO
	bool "HPMicro synchronization timer driver"
	default y
	depends on CLOCK_CONTROL
	depends on DT_HAS_HPMICRO_HPM_SYNT_ENABLED
	depends on HAS_HPMSDK_SYNT
	select USE_HPMSDK_SYNT
	help
	  Enable the HPMicro synchronization timer. It provides the motor-system
	  synchronization counter, comparator events and the shared timestamp.

DT_COMPAT_HPM_PLB := hpmicro,hpm-plb

config PLB_HPMICRO
	bool "HPMicro programmable logic block driver"
	default y
	depends on CLOCK_CONTROL
	depends on DT_HAS_HPMICRO_HPM_PLB_ENABLED
	depends on HAS_HPMSDK_PLB
	select USE_HPMSDK_PLB
	help
	  Enable the HPMicro programmable logic block. The driver exposes the
	  TYPE_A truth tables and TYPE_B slice, comparator and counter primitives;
	  SDK PLB filter and encoder components are not built.

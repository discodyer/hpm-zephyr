DT_COMPAT_HPM_DAC := hpmicro,hpm-dac

config DAC_HPMICRO
	bool "HPMicro DAC12 driver"
	default y
	depends on DAC
	depends on DT_HAS_HPMICRO_HPM_DAC_ENABLED
	depends on HAS_HPMSDK_DAC
	select USE_HPMSDK_DAC
	help
	  Enable the HPMicro 12-bit DAC driver. The standard DAC API exposes
	  direct mode. The HPMicro extension API also exposes the four step
	  generators, dual internal buffers, software/hardware triggers and
	  completion status flags.

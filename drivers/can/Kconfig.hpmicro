DT_COMPAT_HPM_MCAN := hpmicro,hpm-mcan

config CAN_HPMICRO
	bool "HPMicro MCAN CAN-FD driver"
	depends on CAN
	default y
	depends on DT_HAS_HPMICRO_HPM_MCAN_ENABLED
	depends on HAS_HPMSDK_MCAN
	select CAN_MCAN
	select CAN_RX_TIMESTAMP
	select PINCTRL
	help
	  Enable the HPMicro MCAN driver using the generic Bosch M_CAN backend.
	  The HPM extension configures the M_CAN timestamping unit and supports
	  selecting PTPC0 or PTPC1 as its external timebase. Enabling this driver
	  also enables the generic CAN receive timestamp field, which carries a
	  TSU slot reference while external TSU timestamping is active.

DT_COMPAT_HPM_DMA := hpmicro,hpm-dma

config DMA_HPMICRO
	bool "HPMicro HDMA/DMAMUX driver"
	default y
	depends on DMA
	depends on CLOCK_CONTROL
	depends on ARCH_HAS_NOCACHE_MEMORY_SUPPORT
	depends on DT_HAS_HPMICRO_HPM_DMA_ENABLED
	depends on HAS_HPMSDK_DMAV2
	depends on HAS_HPMSDK_DMAMUX
	select USE_HPMSDK_DMAV2
	select USE_HPMSDK_DMAMUX
	select NOCACHE_MEMORY
	help
	  Enable the HPMicro DMAV2 controller with its channel-coupled DMAMUX.
	  Memory-to-memory, memory-to-peripheral and peripheral-to-memory
	  transfers are supported. Multiple transfer blocks are connected with
	  hardware linked descriptors.

if DMA_HPMICRO

config DMA_HPMICRO_MAX_BLOCKS
	int "Maximum DMA transfer blocks per channel"
	range 1 256
	default 16
	help
	  Maximum number of blocks in one Zephyr dma_config() transfer list.
	  The driver allocates this many linked descriptors for every channel.
	  Each descriptor requires 32 bytes of non-cacheable RAM.

endif # DMA_HPMICRO

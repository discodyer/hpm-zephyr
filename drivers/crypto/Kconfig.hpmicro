DT_COMPAT_HPM_SDP := hpmicro,hpm-sdp

config CRYPTO_HPMICRO
	bool "HPMicro SDP crypto accelerator driver"
	default y
	depends on CRYPTO
	depends on CLOCK_CONTROL
	depends on DT_HAS_HPMICRO_HPM_SDP_ENABLED
	depends on HAS_HPMSDK_SDP
	depends on ARCH_HAS_NOCACHE_MEMORY_SUPPORT
	select NOCACHE_MEMORY
	select USE_HPMSDK_SDP
	help
	  Zephyr crypto driver for the HPMicro secure data processor (SDP).
	  The driver exposes synchronous AES-128/256 ECB, CBC, CTR and CCM,
	  SHA-256, plus HPMicro-only SHA-1, CRC-32, SM3 and SM4 extensions
	  through direct HAL calls. CTR accepts 32- to 120-bit counters.

if CRYPTO_HPMICRO

config CRYPTO_HPMICRO_MAX_SESSIONS
	int "Maximum number of SDP crypto sessions"
	range 1 4
	default 2
	help
	  Number of concurrent cipher or hash sessions tracked by the driver.
	  Hardware operations themselves are serialized.

config CRYPTO_HPMICRO_BOUNCE_SIZE
	int "SDP DMA bounce buffer size"
	range 256 4096
	default 1024
	help
	  Size of each non-cacheable staging buffer used for SDP input and
	  output. Larger requests are processed in chunks. The buffers are
	  placed in the Zephyr nocache RAM region.

config CRYPTO_HPMICRO_TIMEOUT_US
	int "SDP operation timeout (microseconds)"
	range 1 60000000
	default 1000000
	help
	  Maximum time to wait for an SDP operation to complete. SDP HAL calls
	  are synchronous and poll the hardware status. A timeout prevents a
	  stalled or misconfigured controller from blocking the calling thread
	  indefinitely.

endif # CRYPTO_HPMICRO

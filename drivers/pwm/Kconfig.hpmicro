DT_COMPAT_HPM_PWM := hpmicro,hpm-pwm

config PWM_HPMICRO
	bool "HPMicro PWM driver"
	depends on PWM
	default y
	depends on DT_HAS_HPMICRO_HPM_PWM_ENABLED
	depends on HAS_HPMSDK_PWM
	select USE_HPMSDK_PWM
	help
	  Enable the HPMicro PWM driver. The standard PWM API provides basic
	  edge-aligned outputs. When PWM_CAPTURE is enabled, comparators configured
	  as capture inputs also support the standard Zephyr capture API using an
	  independent block with a free-running 28-bit counter. Capture cannot be
	  enabled on a block that has configured outputs during the current boot.
	  Measured periods must be shorter than one full 28-bit counter cycle.
	  The HPMicro extension API provides complementary outputs with dead-time
	  insertion, fault handling, and raw input-capture access.

DT_COMPAT_HPMICRO_HPM_I2C := hpmicro,hpm-i2c

config I2C_HPMICRO
	bool "HPMicro I2C driver"
	default y
	depends on I2C
	depends on DT_HAS_HPMICRO_HPM_I2C_ENABLED
	depends on HAS_HPMSDK_I2C
	select USE_HPMSDK_I2C
	help
	  Enable the HPMicro I2C controller driver.

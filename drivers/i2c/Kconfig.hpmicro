DT_COMPAT_HPMICRO_HPM_I2C := hpmicro,hpm-i2c

config I2C_HPMICRO
	bool "HPMicro I2C driver"
	default y
	depends on I2C
	depends on DT_HAS_HPMICRO_HPM_I2C_ENABLED
	depends on HAS_HPMSDK_I2C
	select USE_HPMSDK_I2C
	help
	  Enable the HPMicro I2C controller driver.

if I2C_HPMICRO

config I2C_HPMICRO_DMA
	bool "Use DMA for controller transfers"
	default y if DT_HAS_HPMICRO_HPM_DMA_ENABLED
	select DMA
	help
	  Use DMA for controller-mode data phases when the I2C node has a
	  matching DMA channel. The I2C controller still owns address and
	  start/stop phases. Disable to use the polling path.

config I2C_HPMICRO_DMA_TIMEOUT_MS
	int "I2C DMA transaction timeout"
	depends on I2C_HPMICRO_DMA
	default 1000
	range 1 60000
	help
	  Maximum time to wait for the DMA channel and I2C transaction-complete
	  interrupt during a controller-mode transfer.

endif # I2C_HPMICRO

DT_COMPAT_HPM_TRGM := hpmicro,hpm-trgm

config MUX_HPMICRO_TRGM
	bool "HPMicro TRGM trigger routing driver"
	default y
	depends on MUX
	depends on CLOCK_CONTROL
	depends on DT_HAS_HPMICRO_HPM_TRGM_ENABLED
	depends on HAS_HPMSDK_TRGM
	select USE_HPMSDK_TRGM
	help
	  Enable the HPMicro TRGM driver as a Zephyr mux controller. Each
	  mux control selects one TRGM output; the mux state selects the TRGM
	  input source using the HPM_TRGM0_INPUT_SRC_* values from the SDK.
	  The HPM-specific extension also provides input filtering, output
	  polarity and edge-pulse conversion, DMA request routing, and the
	  ADC, DAC and position routing matrices. Named motor-control routes
	  connect SYNT, MMC, SEI, RDC, QEO and PLB without duplicating TRGM
	  output indices in those drivers.

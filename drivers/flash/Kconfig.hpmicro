DT_COMPAT_HPMICRO_XPI := hpmicro,xpi

config FLASH_HPMICRO
	bool "HPMicro XPI NOR flash driver"
	default y
	depends on FLASH
	depends on DT_HAS_HPMICRO_XPI_ENABLED
	select FLASH_HAS_DRIVER_ENABLED
	select FLASH_HAS_EXPLICIT_ERASE
	select FLASH_HAS_PAGE_LAYOUT
	help
	  Enable the HPMicro XPI NOR flash driver backed by the HPM SDK ROM APIs.

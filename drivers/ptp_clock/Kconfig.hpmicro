DT_COMPAT_HPM_PTPC := hpmicro,hpm-ptpc

config PTP_CLOCK_HPMICRO
	bool "HPMicro PTPC clock driver"
	default y
	depends on PTP_CLOCK
	depends on CLOCK_CONTROL
	depends on DT_HAS_HPMICRO_HPM_PTPC_ENABLED
	depends on HAS_HPMSDK_PTPC
	select USE_HPMSDK_PTPC
	select SHARED_INTERRUPTS
	help
	  Enable the HPMicro PTPC timestamp clock driver. Each enabled child
	  node represents one of the two independent timestamp counters. Both
	  channels share one hardware interrupt line, so shared interrupt support
	  is required when both children are enabled.

if PTP_CLOCK_HPMICRO

module = PTP_CLOCK_HPMICRO
module-str = PTP_CLOCK_HPMICRO
source "subsys/logging/Kconfig.template.log_config"

endif # PTP_CLOCK_HPMICRO

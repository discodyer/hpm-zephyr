DT_COMPAT_HPM_OTP := hpmicro,hpm-otp

config OTP_HPMICRO
	bool "HPMicro OTP controller driver"
	default y
	depends on OTP
	depends on DT_HAS_HPMICRO_HPM_OTP_ENABLED
	depends on HAS_HPMSDK_OTP
	select USE_HPMSDK_OTP
	help
	  Enable the HPMicro OTP controller driver. By default this driver is
	  read-only and accesses the fuse shadow registers. Enabling OTP_PROGRAM
	  additionally exposes irreversible fuse programming.

if OTP_HPMICRO

module = OTP_HPMICRO
module-str = OTP_HPMICRO
source "subsys/logging/Kconfig.template.log_config"

config OTP_HPMICRO_ALLOW_LOCK
	bool "Allow irreversible OTP lock operations"
	default n
	help
	  Expose the HPMicro fuse and shadow lock APIs. Lock settings can be
	  irreversible and may permanently disable fuse programming or reads.
	  Leave this disabled unless the product provisioning flow explicitly
	  requires it.

config OTP_HPMICRO_ALLOW_REGION_CONFIG
	bool "Allow configurable OTP region changes"
	default n
	help
	  Expose the ROM helper that redefines OTP region 3. Changing the region
	  can alter which fuse words are covered by provisioning and locks.

config OTP_HPMICRO_SIZE
	int "HPMicro OTP addressable bytes"
	default 512
	range 4 512
	help
	  Size of the HPM5361 OTP shadow array exposed through the Zephyr OTP
	  API. The hardware has 128 32-bit words.

endif # OTP_HPMICRO

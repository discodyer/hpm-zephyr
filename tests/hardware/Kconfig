mainmenu "HPM5361 hardware acceptance"

choice HPM_TEST_PROFILE
	prompt "Isolated acceptance profile"
	default HPM_TEST_CORE

config HPM_TEST_CORE
	bool "core"

config HPM_TEST_DMA
	bool "dma"

config HPM_TEST_CRYPTO
	bool "crypto"

config HPM_TEST_FLASH
	bool "flash"
	help
	  Erase and program the dedicated XPI NOR scratch partition, then
	  verify readback and cache visibility through the XIP mapping.

config HPM_TEST_WATCHDOG
	bool "watchdog"
	help
	  Verify watchdog feeding and timeout callbacks without resetting
	  the board, using the EWDG0 interrupt-only mode.

config HPM_TEST_CAN
	bool "can"
	help
	  Verify classic CAN, CAN FD and PTPC timestamps using internal MCAN0
	  loopback, without requiring an external CAN bus.

config HPM_TEST_MOTOR
	bool "motor"
	help
	  Verify internal SYNT, PLB, QEO, MMC and GPIOM operations without
	  requiring external motor-control hardware.

config HPM_TEST_GPIO
	bool "gpio"
	help
	  Verify GPIO levels, raw port operations and edge interrupts using
	  an external jumper between the fixture output and input pins.

config HPM_TEST_UART
	bool "uart"
	help
	  Verify UART1 asynchronous DMA transfers and RTS/CTS flow control
	  using external data and flow-control loopback jumpers.

config HPM_TEST_I2C
	bool "i2c"
	help
	  Verify I2C0 controller DMA transfers against an I2C1 target and
	  SMBus data, block, and PEC operations using external loopback wires.

config HPM_TEST_SPI
	bool "spi"
	help
	  Verify SPI1 synchronous and asynchronous DMA transfers in all four
	  modes using an external MOSI-to-MISO loopback wire.

endchoice

source "Kconfig.zephyr"

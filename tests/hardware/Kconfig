mainmenu "HPM5361 hardware acceptance"

choice HPM_TEST_PROFILE
	prompt "Isolated acceptance profile"
	default HPM_TEST_CORE

config HPM_TEST_CORE
	bool "core"

config HPM_TEST_DMA
	bool "dma"

config HPM_TEST_CRYPTO
	bool "crypto"

config HPM_TEST_FLASH
	bool "flash"
	help
	  Erase and program the dedicated XPI NOR scratch partition, then
	  verify readback and cache visibility through the XIP mapping.

config HPM_TEST_WATCHDOG
	bool "watchdog"
	help
	  Verify watchdog feeding and timeout callbacks without resetting
	  the board, using the EWDG0 interrupt-only mode.

config HPM_TEST_CAN
	bool "can"
	help
	  Verify classic CAN, CAN FD and PTPC timestamps using internal MCAN0
	  loopback, without requiring an external CAN bus.

config HPM_TEST_PTPC
	bool "PTPC clock, PPS and rate adjustment"
	help
	  Verify both PTPC timestamp channels, shared interrupt dispatch, PPS
	  events, time adjustment and rate adjustment without external wiring.
	  The profile also checks counter initialization from reset and per-channel
	  callback dispatch.

config HPM_TEST_MOTOR
	bool "motor"
	help
	  Verify internal SYNT, PLB, QEO, MMC and GPIOM operations without
	  requiring external motor-control hardware.

config HPM_TEST_GPIO
	bool "gpio"
	help
	  Verify GPIO levels, raw port operations and edge interrupts using
	  an external jumper between the fixture output and input pins.

config HPM_TEST_UART
	bool "uart"
	help
	  Verify UART1 asynchronous DMA transfers and RTS/CTS flow control
	  using external data and flow-control loopback jumpers.

config HPM_TEST_LIN
	bool "LIN"
	help
	  Verify the standard LIN commander/responder API, both checksum
	  modes, header filtering, receive timeout and wakeup generation.
	  The fixture connects UART1 and UART2 directly at TTL level.

config HPM_TEST_UART_ADDRESS
	bool "UART address matching"
	help
	  Verify HPM UART nine-bit address matching using cross-connected
	  UART1 and UART2, including rejection of non-matching addresses.

config HPM_TEST_UART_RS485
	bool "UART RS-485 DE timing"
	help
	  Verify that the UART1 auto-DE output surrounds a complete TX burst and
	  returns low after the final stop bit.

config HPM_TEST_I2C
	bool "i2c"
	help
	  Verify I2C0 controller transfers against an I2C1 target, including
	  7/10-bit addressing, repeated START, SMBus data/PEC and SCL/SDA bus
	  recovery using external loopback wires.

config HPM_TEST_SPI
	bool "spi"
	help
	  Verify SPI1 synchronous and asynchronous DMA transfers in all four
	  modes using an external MOSI-to-MISO loopback wire.

config HPM_TEST_ANALOG
	bool "analog"
	help
	  Enable the analog hardware test for DAC0 output, ADC0 synchronous and
	  asynchronous conversion, preemption DMA, and TRGM-triggered conversion over
	  an external loopback wire.

config HPM_TEST_FRONT_END
	bool "analog front end"
	help
	  Verify the OPAMP0 voltage follower and ACMP1 threshold interrupts
	  using DAC0 output and external signal loopback wires.

config HPM_TEST_PWM
	bool "PWM output and capture"
	help
	  Verify PWM0 output with PWM1 input capture and GPIO readback over
	  external signal loopback wires.

config HPM_TEST_QEI
	bool "Quadrature encoder"
	help
	  Verify QEIV2 digital counts, rotation and comparator callbacks using
	  GPIO-generated A/B quadrature signals over external loopback wires.

config HPM_TEST_QEI_PD
	bool "Pulse/direction encoder"
	help
	  Verify QEIV2 pulse/direction decoding with GPIO-generated pulse and
	  direction signals over external loopback wires.

config HPM_TEST_QEI_UD
	bool "Up/down encoder"
	help
	  Verify QEIV2 up/down decoding with independent GPIO-generated up and
	  down pulse signals over external loopback wires.

config HPM_TEST_QEI_SINGLE
	bool "Single-phase encoder"
	help
	  Verify QEIV2 single-phase decoding using a GPIO-generated pulse
	  train over an external loopback wire.

config HPM_TEST_QEI_UVW
	bool "UVW encoder"
	help
	  Verify QEIV2 UVW decoding with GPIO-generated three-phase U, V and W
	  signals over external loopback wires.

config HPM_TEST_USB_DEVICE
	bool "USB device CDC ACM"
	help
	  Verify USB0 enumeration and CDC ACM data transfers using the board's
	  USB OTG connector and a host running the hardware test peer script.

config HPM_TEST_USB_ENDPOINTS
	bool "USB device endpoint matrix"
	help
	  Verify every non-control USB0 IN/OUT endpoint with checked bulk data
	  and a host running the endpoint peer script.

config HPM_TEST_USB_HOST
	bool "USB host boot keyboard"
	help
	  Verify USB0 host enumeration, HID control requests and interrupt-IN
	  reports using a USB boot keyboard connected through an OTG adapter.

config HPM_TEST_USB_HOST_HID_REPORT
	bool "USB host HID report protocol"
	help
	  Verify USB0 host HID report-descriptor retrieval and interrupt-IN
	  traffic while a boot-capable keyboard operates in report protocol.

endchoice

config HPM_TEST_USB_HOST_HUB
	bool "USB host external hub"
	depends on HPM_TEST_USB_HOST
	help
	  Require the boot keyboard to be connected through an external
	  high-speed USB hub and validate the downstream low-speed split path.
	  The test also checks the Hub parent relationship and negotiated speeds
	  so that a directly connected keyboard cannot satisfy the profile.

source "Kconfig.zephyr"

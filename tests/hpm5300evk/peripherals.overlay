#include <dt-bindings/comparator/hpmicro-acmp.h>

/ {
	aliases {
		watchdog0 = &ewdg0;
	};

	chosen {
		zephyr,crc = &crc0;
	};
};

&ewdg0 {
	status = "okay";
};

/ {
	aliases {
		counter0 = &gptmr0;
	};
};

&gptmr0 {
	status = "okay";
};

&pwm0 {
	status = "okay";
	pinctrl-0 = <&pa04_pwm0_p_0>;
	pinctrl-names = "default";
};

/ {
	aliases {
		can0 = &mcan0;
	};
};

&mcan0 {
	status = "okay";
	pinctrl-0 = <&pa16_mcan0_txd &pa17_mcan0_rxd>;
	pinctrl-names = "default";
};

&mcan1 {
	status = "okay";
	pinctrl-0 = <&pa20_mcan1_rxd &pa21_mcan1_txd>;
	pinctrl-names = "default";
};

&mcan2 {
	status = "okay";
	pinctrl-0 = <&pa08_mcan2_txd &pa09_mcan2_rxd>;
	pinctrl-names = "default";
};

&mcan3 {
	status = "okay";
	pinctrl-0 = <&pa14_mcan3_rxd &pa15_mcan3_txd>;
	pinctrl-names = "default";
};

/ {
	zephyr,user {
		io-channels = <&adc0 0>, <&dac0 0>;
	};
};

&adc0 {
	status = "okay";
	vref-mv = <3300>;
	#address-cells = <1>;
	#size-cells = <0>;

	channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <0>;
		zephyr,resolution = <12>;
	};
};

&dac0 {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	channel@0 {
		reg = <0>;
		zephyr,resolution = <12>;
	};
};

&acmp1 {
	status = "okay";
	pinctrl-0 = <&pb09_acmp_comp_1 &pb11_analog>;
	pinctrl-names = "default";
	positive-input = <HPM_ACMP_INPUT_DAC_OUT>;
	negative-input = <HPM_ACMP_INPUT_ANALOG_4>;
	dac-value = <128>;
	hysteresis = <3>;
	enable-output-pin;
};

&opamp0 {
	status = "okay";
	pinctrl-0 = <&pb00_analog &pb04_analog>;
	pinctrl-names = "default";
	functional-mode = "follower";
	positive-input = "INP0";
	negative-input = "FLOATING";
	gain = "OPAMP_GAIN_2";
	miller-capacitor = "x7";
	phase-margin-capacitor;
};

&rng {
	status = "okay";
	self-test;
};

&crc0 {
	status = "okay";
};

&tsns0 {
	status = "okay";
	averaging = <3>;
	measurement-speed = <96>;
};

&ptpc0 {
	status = "okay";
};

&otp {
	status = "okay";
};

&mbx0a {
	status = "okay";
};

&mbx0b {
	status = "okay";
};

&hdma {
	status = "okay";
};

&qei0 {
	status = "okay";
	pinctrl-0 = <&pb12_qei0_a &pb13_qei0_b &pb14_qei0_z>;
	pinctrl-names = "default";
	mode = "abz";
	counts-per-revolution = <4096>;
	z-calibration;
};

&trgm0 {
	status = "okay";
};

/ {
	mux_consumer: mux-consumer {
		compatible = "hpmicro,mux-consumer-test";
		mux-controls = <&trgm0 32>;
		mux-states = <&trgm0 32 8>;
		status = "okay";
	};
};

&fgpioa {
	status = "okay";
};

&gpiom0 {
	status = "okay";
};

&qeo0 {
	status = "okay";
	lines = <1024>;
	max-frequency = <100000>;
	watchdog-frequency = <100000>;
	output-type = "abz";
	z-pulse-width = "75-percent";
};

&sei {
	status = "okay";
};

&mmc0 {
	status = "okay";
};

&rdc {
	status = "okay";
};

&synt {
	status = "okay";
};

&plb {
	status = "okay";
};

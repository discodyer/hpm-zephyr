/ {
	aliases {
		watchdog0 = &ewdg0;
	};
};

&ewdg0 {
	status = "okay";
};

/ {
	aliases {
		counter0 = &gptmr0;
	};
};

&gptmr0 {
	status = "okay";
};

&pwm0 {
	status = "okay";
	pinctrl-0 = <&pa04_pwm0_p_0>;
	pinctrl-names = "default";
};

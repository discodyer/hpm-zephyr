/ {
	aliases {
		watchdog0 = &ewdg0;
	};
};

&ewdg0 {
	status = "okay";
};

/ {
	aliases {
		counter0 = &gptmr0;
	};
};

&gptmr0 {
	status = "okay";
};

&pwm0 {
	status = "okay";
	pinctrl-0 = <&pa04_pwm0_p_0>;
	pinctrl-names = "default";
};

/ {
	aliases {
		can0 = &mcan0;
	};
};

&mcan0 {
	status = "okay";
	pinctrl-0 = <&pa16_mcan0_txd &pa17_mcan0_rxd>;
	pinctrl-names = "default";
};

&mcan1 {
	status = "okay";
	pinctrl-0 = <&pa20_mcan1_rxd &pa21_mcan1_txd>;
	pinctrl-names = "default";
};

&mcan2 {
	status = "okay";
	pinctrl-0 = <&pa08_mcan2_txd &pa09_mcan2_rxd>;
	pinctrl-names = "default";
};

&mcan3 {
	status = "okay";
	pinctrl-0 = <&pa14_mcan3_rxd &pa15_mcan3_txd>;
	pinctrl-names = "default";
};

/ {
	zephyr,user {
		io-channels = <&adc0 0>;
	};
};

&adc0 {
	status = "okay";
	vref-mv = <3300>;
	#address-cells = <1>;
	#size-cells = <0>;

	channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <0>;
		zephyr,resolution = <12>;
	};
};

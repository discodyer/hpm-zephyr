#include <dt-bindings/pinctrl/hpmicro-pinctrl-common.h>

&pinctrl {
	pinmux_uart0: pinmux_uart0 {
		group0 {
			pinmux = <HPMICRO_PINMUX(HPMICRO_PIN(HPMICRO_PORTA, 0),
						 IOC_TYPE_IOC, 0, 2)>,
				 <HPMICRO_PINMUX(HPMICRO_PIN(HPMICRO_PORTA, 1),
						 IOC_TYPE_IOC, 0, 2)>;
		};
	};

	pinmux_i2c0: pinmux_i2c0 {
		group0 {
			pinmux = <HPMICRO_PINMUX(HPMICRO_PIN(HPMICRO_PORTB, 2),
						 IOC_TYPE_IOC, 0, 4)>,
				 <HPMICRO_PINMUX(HPMICRO_PIN(HPMICRO_PORTB, 3),
						 IOC_TYPE_IOC, 0, 4)>;
			drive-open-drain;
			bias-pull-up;
			input-enable;
		};
	};

	pinmux_spi1: pinmux_spi1 {
		group0 {
			pinmux = <HPMICRO_PINMUX(HPMICRO_PIN(HPMICRO_PORTA, 26),
						 IOC_TYPE_IOC, 0, 5)>,
				 <HPMICRO_PINMUX(HPMICRO_PIN(HPMICRO_PORTA, 27),
						 IOC_TYPE_IOC, 0, 5)>,
				 <HPMICRO_PINMUX(HPMICRO_PIN(HPMICRO_PORTA, 28),
						 IOC_TYPE_IOC, 0, 5)>,
				 <HPMICRO_PINMUX(HPMICRO_PIN(HPMICRO_PORTA, 29),
						 IOC_TYPE_IOC, 0, 5)>;
			hpmicro-slew-rate = "fast";
			hpmicro-slew-pd = "200M";
		};
	};
};

/dts-v1/;

#include <hpmicro/hpm5361.dtsi>
#include "hpm5300evk-pinctrl.dtsi"

/ {
	model = "HPMicro HPM5300EVK";
	compatible = "hpmicro,hpm5300evk";

	chosen {
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
		zephyr,sram = &sram;
		zephyr,itcm = &ilm;
	};

	leds {
		compatible = "gpio-leds";

		led0: led_0 {
			gpios = <&gpioa 23 GPIO_ACTIVE_LOW>;
			label = "LED0";
		};
	};

	aliases {
		led0 = &led0;
	};
};

&uart0 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&pinmux_uart0>;
	pinctrl-names = "default";
};

&gpioa {
	status = "okay";
};

&xpi0 {
	status = "okay";

	flash0: flash@0 {
		compatible = "hpmicro,hpmicro-flash", "soc-nv-flash";
		reg = <0x80000000 DT_SIZE_M(1)>;
		status = "okay";
		erase-block-size = <4096>;
		write-block-size = <1>;
	};
};

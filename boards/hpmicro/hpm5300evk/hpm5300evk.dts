/dts-v1/;

#include <hpmicro/hpm5361.dtsi>
#include "hpm5300evk-pinctrl.dtsi"

/ {
	model = "HPMicro HPM5300EVK";
	compatible = "hpmicro,hpm5300evk";

	chosen {
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
		zephyr,sram = &sram;
		zephyr,itcm = &ilm;
		zephyr,flash = &flash0;
		zephyr,flash-controller = &xpi0;
		zephyr,code-partition = &slot0_partition;
	};

	leds {
		compatible = "gpio-leds";

		led0: led_0 {
			gpios = <&gpioa 23 GPIO_ACTIVE_LOW>;
			label = "LED0";
		};
	};

	aliases {
		led0 = &led0;
	};
};

&uart0 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&pinmux_uart0>;
	pinctrl-names = "default";
};

&gpioa {
	status = "okay";
};

&xpi0 {
	status = "okay";

	flash0: flash@80000000 {
		compatible = "hpmicro,hpmicro-flash", "soc-nv-flash";
		reg = <0x80000000 DT_SIZE_M(1)>;
		ranges = <0x0 0x80000000 DT_SIZE_M(1)>;
		#address-cells = <1>;
		#size-cells = <1>;
		status = "okay";
		erase-block-size = <4096>;
		write-block-size = <1>;
		nor-cfg-opt-hdr = <0xfcf90002>;
		nor-cfg-opt-opt0 = <0x00000005>;
		nor-cfg-opt-opt1 = <0x00001000>;

		partitions {
			ranges;
			#address-cells = <1>;
			#size-cells = <1>;

			boot_partition: partition@0 {
				compatible = "zephyr,mapped-partition";
				label = "bootrom";
				reg = <0x0 0x3000>;
				read-only;
			};

			slot0_partition: partition@3000 {
				compatible = "zephyr,mapped-partition";
				label = "image-0";
				reg = <0x3000 0xfd000>;
			};
		};
	};
};

#include <dt-bindings/pinctrl/hpmicro-pinctrl-common.h>

&pinctrl {
	pinmux_uart0: pinmux_uart0 {
		group0 {
			pinmux = <HPMICRO_PINMUX(HPMICRO_PIN(HPMICRO_PORTA, 0),
						 IOC_TYPE_IOC, 0, 2)>,
				 <HPMICRO_PINMUX(HPMICRO_PIN(HPMICRO_PORTA, 1),
						 IOC_TYPE_IOC, 0, 2)>;
		};
	};
};

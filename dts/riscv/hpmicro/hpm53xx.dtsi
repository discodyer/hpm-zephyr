			compatible = "hpmicro,hpm-otp";
			reg = <0xf3050000 0x1000>;
			interrupts = <57 1>;
			interrupt-parent = <&plic>;
			status = "disabled";
		};

		keym: keym@f3054000 {
			compatible = "hpmicro,hpm-keym";
			reg = <0xf3054000 0x1000>;
			clocks = <&clk CLOCK_KMAN CLK_SRC_OSC24M 1>;
			clock-names = "keym";
			status = "disabled";
		};

		rng: rng@f304c000 {
			compatible = "hpmicro,hpm-rng";
			reg = <0xf304c000 0x1000>;
			interrupts = <56 1>;
			interrupt-parent = <&plic>;
			clocks = <&clk CLOCK_RNG CLK_SRC_OSC24M 1>;
			clock-names = "rng";
			status = "disabled";
		};

		adc0: adc@f3080000 {
			compatible = "hpmicro,hpm-adc16";
			reg = <0xf3080000 0x4000>;
			interrupts = <58 1>;
			interrupt-parent = <&plic>;
			clocks = <&clk CLOCK_ADC0 CLK_SRC_PLL0_CLK2 2>;
			clock-names = "adc";
			clock-name = <CLOCK_ADC0>;
			clock-src = <CLK_ADC_SRC_ANA0>;
			ana-clock-name = <CLOCK_ANA0>;
			ana-clock-src = <CLK_SRC_PLL0_CLK2>;
			#io-channel-cells = <1>;
			status = "disabled";
		};

		adc1: adc@f3084000 {
			compatible = "hpmicro,hpm-adc16";
			reg = <0xf3084000 0x4000>;
			interrupts = <59 1>;
			interrupt-parent = <&plic>;
			clocks = <&clk CLOCK_ADC1 CLK_SRC_PLL0_CLK2 2>;

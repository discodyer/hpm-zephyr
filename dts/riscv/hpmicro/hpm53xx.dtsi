		acmp: comparator@f30b0000 {
			compatible = "hpmicro,hpm-acmp";
			reg = <0xf30b0000 0x4000>;
			interrupts = <62 1>, <63 1>;
			interrupt-parent = <&plic>;
			clocks = <&clk CLOCK_ACMP0 CLK_SRC_OSC24M 1>;
			clock-names = "acmp";
			status = "disabled";
		};
	};
};

&gpio0 {
	/*
	 * All GPIO ports share the GPIO0 register block. The unit-address is
	 * only a unique node identifier; hpmicro-gpio-port selects the port.
	 */
	gpioa: gpio@0 {
		compatible = "hpmicro,hpm-gpio";
		reg = <0x0 0x4000>;
		ngpios = <32>;
		gpio-controller;
		#gpio-cells = <2>;
		hpmicro-gpio-port = <0>;
		interrupts = <1 1>;
		interrupt-parent = <&plic>;
	};

	gpiob: gpio@1 {
		compatible = "hpmicro,hpm-gpio";
		reg = <0x0 0x4000>;
		ngpios = <32>;
		gpio-controller;
		#gpio-cells = <2>;
		hpmicro-gpio-port = <1>;
		interrupts = <2 1>;
		interrupt-parent = <&plic>;
	};

	gpiox: gpio@2 {
		compatible = "hpmicro,hpm-gpio";
		reg = <0x0 0x4000>;
		ngpios = <8>;
		gpio-controller;
		#gpio-cells = <2>;
		hpmicro-gpio-port = <13>;
		interrupts = <3 1>;
		interrupt-parent = <&plic>;
		status = "disabled";
	};

	gpioy: gpio@3 {
		compatible = "hpmicro,hpm-gpio";
		reg = <0x0 0x4000>;
		ngpios = <8>;
		gpio-controller;
		#gpio-cells = <2>;
		hpmicro-gpio-port = <14>;
		interrupts = <4 1>;
		interrupt-parent = <&plic>;
		status = "disabled";
	};
};
